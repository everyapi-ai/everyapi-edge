# EveryAPI edge agent — copy to .env and fill in the supplier-specific
# values. Required fields are marked REQUIRED; everything else is
# optional metadata that helps the dashboard render useful badges and
# helps buyers filter for "EU node" / "RTX 4090 only" etc.

# REQUIRED — base URL of the EveryAPI gateway.
EVERYAPI_GATEWAY=https://api.everyapi.ai

# REQUIRED — paste from the dashboard after you click "New node".
EVERYAPI_NODE_ID=

# REQUIRED on first run ONLY. After the first successful connect this
# value is consumed server-side; you can blank it out and the agent
# will continue authenticating with its Ed25519 identity. Leaving the
# expired value in place is harmless but the gateway will reject
# attempted reuse.
EVERYAPI_REGISTRATION_TOKEN=

# Optional metadata — empty values just don't get reported.
EVERYAPI_NODE_NAME=home-rtx4090
EVERYAPI_GPU_MODEL=NVIDIA GeForce RTX 4090
EVERYAPI_VRAM_GB=24
EVERYAPI_PLATFORM=linux/amd64
EVERYAPI_COUNTRY=US

# Local model storage. All three paths default here when omitted; keep the image
# and speech caches under the same Edge-owned directory so all local model data
# travels together during storage migration.
EVERYAPI_MODEL_PATH=${HOME}/.everyapi/edge
EVERYAPI_IMAGE_MODEL_PATH=${HOME}/.everyapi/edge/images
EVERYAPI_SPEECH_MODEL_PATH=${HOME}/.everyapi/edge/speech

# Optional Hugging Face token for gated/private model downloads. The bundled
# Sana 0.6B generator is public and does not require it.
HF_TOKEN=

# REQUIRED — Edge Control Room pairing token. On macOS/Linux run `openssl rand -hex 32`; on Windows use the PowerShell CSPRNG command in README or rerun install.ps1. Docker Compose refuses to start while this value is empty.
EVERYAPI_CONSOLE_TOKEN=

# Docker Compose publishes the Control Room on the node's trusted LAN at http://<node-LAN-IP>:8421. Pairing authenticates the browser, but the connection still uses plain HTTP: never expose this port to the Internet. Set EVERYAPI_CONSOLE_PORT to use another host port.

# Pin the agent image version. Floating to :latest is OK for early
# adopters; ops-conscious suppliers should pin to a specific tag.
EVERYAPI_EDGE_VERSION=latest
